# ---------------------------------------------------------------------------
# Neon Postgres — two URLs for the same database, used for different jobs.
#
#   DATABASE_URL  POOLED  (hostname contains "-pooler")
#                 Used by the running server for every API request.
#                 Goes through PgBouncer, which multiplexes thousands of
#                 client connections onto a few real Postgres ones.
#
#   DIRECT_URL    DIRECT  (same host, WITHOUT "-pooler")
#                 Used by `prisma migrate` / `db push` / `studio`.
#                 Migrations take a session-level advisory lock, which
#                 PgBouncer cannot hold — through the pooler they hang.
#
# Get both from the Neon console -> Connection Details, by toggling
# "Connection pooling" on (DATABASE_URL) and off (DIRECT_URL).
# The two strings should differ ONLY by the "-pooler" suffix.
# Keep ?sslmode=require on both; Neon refuses plaintext connections.
#
# Run `npm run db:check` after filling these in — it verifies both and
# explains anything that is wrong, without printing your credentials.
#
# Local or self-hosted Postgres: set DATABASE_URL only and leave DIRECT_URL
# empty; there is no pooler, so migrations fall back to DATABASE_URL.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Auth — generate each secret with: openssl rand -base64 48
# They MUST be different from each other and at least 32 characters.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string-32"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Cost factor for bcrypt password hashing.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# EPUB library
# Where uploaded .epub files are written. A container filesystem is usually
# ephemeral — in production point this at a mounted volume (or swap
# src/utils/fileStorage.ts for S3/R2).
# ---------------------------------------------------------------------------
UPLOAD_DIR="./uploads"

# Largest accepted .epub, in bytes (default 25 MiB).
EPUB_MAX_BYTES=26214400

# Seed credentials for the first admin account (npm run db:seed).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin123!pass"
SEED_ADMIN_NAME="Site Admin"
