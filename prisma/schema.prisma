// Prisma schema — PostgreSQL (Neon)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (for migrate/introspect)
  // and in the driver adapter passed to PrismaClient (for runtime queries).
}

/// Application roles. ADMIN can manage every user and every post;
/// USER can only manage their own account and their own posts.
enum Role {
  USER
  ADMIN
}

/// An organisational unit a user belongs to — IT, Accounting, Economics, ...
///
/// Kept as a table rather than an enum so departments can be created and
/// renamed at runtime without a migration and a redeploy.
model Department {
  id          String   @id @default(uuid()) @db.Uuid
  /// Human-readable label, e.g. "Information Technology".
  name        String   @unique
  /// Short uppercase handle used in URLs, reports and imports, e.g. "IT".
  code        String   @unique
  description String?
  /// A retired department keeps its history but accepts no new members.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([isActive])
  @@map("departments")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  /// Argon2id/bcrypt hash — never the plaintext password.
  password  String
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  /// Which department the user belongs to. Optional: an account can exist
  /// before it has been placed, and deleting a department is blocked while
  /// it still has members, so this never dangles.
  departmentId String? @db.Uuid
  /// Any refresh token issued before this instant is rejected.
  /// Bumped on password change and on "log out of all devices".
  tokensValidFrom DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts         Post[]
  refreshTokens RefreshToken[]
  books         Book[]
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([role])
  @@index([departmentId])
  @@map("users")
}

/// The example CRUD resource. Ownership is what the USER role is scoped to.
model Post {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  content   String
  published Boolean  @default(false)
  authorId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([published])
  @@index([createdAt])
  @@map("posts")
}

/// An EPUB in the library. Only an ADMIN may upload, replace or delete one;
/// every authenticated reader may list and download a published book.
///
/// The row holds metadata only — the bytes live in the storage backend under
/// `storageKey`, which keeps large binaries out of Postgres and lets the file
/// be streamed with Range support.
model Book {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  author      String?
  description String?
  language    String?
  /// Unpublished books are visible to admins only — the staging state for a
  /// book that is uploaded but not yet released to readers.
  published   Boolean  @default(false)

  /// The name the admin's browser sent, kept only to name the download.
  originalName String
  /// Opaque `<uuid>.epub` name on disk. Never derived from user input, so a
  /// crafted filename cannot escape the upload directory.
  storageKey   String  @unique
  mimeType     String  @default("application/epub+zip")
  sizeBytes    Int
  /// SHA-256 of the file, for integrity checks and duplicate detection.
  checksum     String  @unique

  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById])
  @@index([published])
  @@index([createdAt])
  @@map("books")
}

/// Refresh tokens are stored as SHA-256 hashes so a database leak
/// cannot be replayed against the API. Rotated on every refresh.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  /// Set when this token is rotated, pointing at its replacement,
  /// so reuse of an old token can be detected.
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
